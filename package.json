{
  "name": "eondrive",
  "version": "2.0.0",
  "description": "Eondrive - Electric Vehicle Database, Comparison & Range Calculator",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare-v1.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "import:images": "node scripts/download-car-images.mjs",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server.cjs"
  },
  "dependencies": {
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
